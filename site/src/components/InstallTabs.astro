---
import { cdnUrl } from '../lib/url'

interface Props {
  name: string
  pkg: string
  version: string
  fnName: string
  platform?: string
}

const { name, pkg, version, fnName, platform } = Astro.props

// CDN first: on Shopify, Squarespace, Wix, GTM and most WordPress installs a merchant can paste a
// script tag but cannot run a build, so npm is the minority path.
const cdnSnippet = `<script src="https://www.datadoghq-browser-agent.com/us1/v6/datadog-rum.js"></script>
<script src="${cdnUrl(pkg, version)}"
        integrity="sha384-REPLACE_FROM_RELEASE" crossorigin="anonymous"></script>
<script>
  window.DD_RUM.init({
    applicationId: 'YOUR_APPLICATION_ID',
    clientToken: 'YOUR_CLIENT_TOKEN',
    site: 'datadoghq.com',
    service: 'storefront',
    sessionSampleRate: 100,
    plugins: [window.DD_RUM_PLUGINS['${name}']()],
  })
</script>`

const npmSnippet = `import { datadogRum } from '@datadog/browser-rum'
import { ${fnName} } from '${pkg}'

datadogRum.init({
  applicationId, clientToken, site, service, env, version,
  plugins: [${fnName}()],
})`

const tabs = [
  { id: 'cdn', label: 'CDN (script tag)', code: cdnSnippet },
  { id: 'npm', label: 'npm', code: npmSnippet },
]
---

<div class="install" data-install>
  <div class="tabs" role="tablist">
    {tabs.map((tab, index) => (
      <button type="button" role="tab" data-tab={tab.id} aria-selected={index === 0 ? 'true' : 'false'}>
        {tab.label}
      </button>
    ))}
  </div>
  {tabs.map((tab, index) => (
    <pre data-panel={tab.id} hidden={index !== 0}><code>{tab.code}</code></pre>
  ))}

  <p class="small muted">
    Paste both tags before <code>&lt;/head&gt;</code>. Replace <code>us1</code> with your Datadog site
    and take the <code>integrity</code> hash from the release — the version is pinned on purpose, and
    there is no <code>latest</code> URL.
    {platform && <> On this platform the usual route is: <strong>{platform}</strong>.</>}
  </p>
</div>

<script>
  for (const group of document.querySelectorAll('[data-install]')) {
    group.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-tab]')
      if (!button) return
      for (const tab of group.querySelectorAll<HTMLButtonElement>('[data-tab]')) {
        tab.setAttribute('aria-selected', String(tab === button))
      }
      for (const panel of group.querySelectorAll<HTMLElement>('[data-panel]')) {
        panel.hidden = panel.dataset.panel !== button.dataset.tab
      }
    })
  }
</script>
