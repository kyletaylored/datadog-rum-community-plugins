---
/**
 * Renders manifest prose, where identifiers are wrapped in backticks, with each one as <code>.
 * Keeps plugin.json plain text while the page still reads like the rest of the docs.
 */
interface Props {
  text: string
}

const parts = Astro.props.text.split('`')
---

{parts.map((part, index) => (index % 2 === 1 ? <code>{part}</code> : part))}
