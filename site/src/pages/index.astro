---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import { url } from '../lib/url'
import plugins from '../data/plugins.json'

const order = ['shopify', 'woocommerce', 'onetrust']
const featured = order
  .map((name) => plugins.find((plugin) => plugin.name === name))
  .filter((plugin) => plugin !== undefined)

const familyIcon: Record<string, 'cart' | 'shield' | 'user' | 'puzzle'> = {
  commerce: 'cart',
  consent: 'shield',
  identity: 'user',
}

const guarantees = [
  { icon: 'block' as const, title: 'No payment data, ever', body: 'Card fields are stripped at any depth, even when the platform’s own payload includes them.' },
  { icon: 'shield' as const, title: 'Consent comes first', body: 'A consent plugin holds RUM until the visitor accepts. Nothing is queued, so nothing is backfilled.' },
  { icon: 'check' as const, title: 'One order, counted once', body: 'Purchases dedupe on transaction_id, so a reloaded thank-you page never double-counts revenue.' },
  { icon: 'bolt' as const, title: 'Under 5 KB', body: 'Per plugin, gzipped, core included. CI fails the build if one goes over.' },
]
---

<Base
  title="Order data in Datadog RUM, from one script tag"
  description="Community Datadog Browser RUM plugins for commerce platforms, consent managers and login providers."
  hero
>
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow"><Icon name="puzzle" size="0.85rem" /> Community plugins</span>
      <h1>Order data in Datadog RUM,<br /><span class="gradient-text">from one script tag</span></h1>
      <p class="lede">
        RUM already tracks sessions, views and errors. It does not know who the shopper is or what
        was in the cart. These plugins read your platform’s own events and turn them into RUM
        actions — no tracking code to write.
      </p>
      <div class="btn-row">
        <a class="btn primary" href={url('/sandbox/')}>See what it sends <Icon name="arrow" size="0.95rem" /></a>
        <a class="btn" href={url('/docs/getting-started/')}>Install guide</a>
      </div>
    </div>
  </section>

  <section class="wrap">
    <h2 id="start">Start with your platform</h2>
    <p class="lede">Each one installs with a script tag and needs no changes to your RUM setup.</p>
    <div class="grid">
      {featured.map((plugin) => (
        <a class="card" href={url(`/plugins/${plugin.name}/`)}>
          <span class="card-icon"><Icon name={familyIcon[plugin.family] ?? 'puzzle'} /></span>
          <h3>{plugin.title ?? plugin.name}</h3>
          <p>{plugin.description}</p>
          <div class="badges">
            <span class="badge">{plugin.family}</span>
            {plugin.events.length > 0 && <span class="badge">{plugin.events.length} events</span>}
            <span class="badge">v{plugin.version}</span>
          </div>
        </a>
      ))}
      <a class="card" href={url('/docs/contributing/')}>
        <span class="card-icon"><Icon name="code" /></span>
        <h3>Your platform missing?</h3>
        <p>BigCommerce, Adobe Commerce, Auth0 and more are open. The scaffold gets you to a working plugin in about a week.</p>
        <div class="badges"><span class="badge">Contribute</span></div>
      </a>
    </div>
  </section>

  <section class="wrap">
    <h2>Add one script tag</h2>
    <p class="lede">
      Works anywhere you can paste a tag — Shopify, WordPress, Google Tag Manager, Squarespace. npm
      too, if you have a build.
    </p>
    <pre><code>{`<script src="https://www.datadoghq-browser-agent.com/us1/v6/datadog-rum.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@kyletaylored/datadog-rum-plugin-woocommerce@0.1.0/dist/plugin.js"
        integrity="sha384-REPLACE_FROM_RELEASE" crossorigin="anonymous"></script>
<script>
  window.DD_RUM.init({
    applicationId: 'YOUR_APPLICATION_ID',
    clientToken: 'YOUR_CLIENT_TOKEN',
    site: 'datadoghq.com',
    plugins: [window.DD_RUM_PLUGINS['woocommerce']()],
  })
</script>`}</code></pre>
  </section>

  <section class="wrap">
    <h2>Safe by default</h2>
    <p class="lede">These run on checkout pages, so the rules live in the shared core — and the test suite fails a release that breaks one.</p>
    <div class="grid">
      {guarantees.map((item) => (
        <div class="card">
          <span class="card-icon"><Icon name={item.icon} /></span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </div>
      ))}
    </div>
    <p style="margin-top:1rem"><a href={url('/docs/privacy/')}>All the privacy rules <Icon name="arrow" size="0.85rem" /></a></p>
  </section>

  <section class="wrap">
    <h2>Then the dashboards</h2>
    <p class="lede">
      Every plugin emits the same schema, so one dashboard and one monitor set work across all of
      them. Orders, revenue, average order value, checkout conversion, and the funnel next to
      checkout errors.
    </p>
    <div class="btn-row">
      <a class="btn" href={url('/docs/datadog-assets/')}>Dashboards & monitors</a>
      <a class="btn" href={url('/docs/schema/')}>Event schema</a>
    </div>
  </section>

  <section class="wrap">
    <div class="callout warn" style="margin-top:3rem">
      <strong>Browser-measured and directional.</strong> Ad blockers, closed tabs and declined
      consent all remove sessions, so these numbers show trends next to errors and slow views. They
      do not replace your platform’s own order report.
    </div>
  </section>
</Base>
