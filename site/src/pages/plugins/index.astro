---
import Base from '../../layouts/Base.astro'
import { url } from '../../lib/url'
import plugins from '../../data/plugins.json'

const families = [...new Set(plugins.map((plugin) => plugin.family))].sort()
const platforms = [...new Set(plugins.flatMap((plugin) => (plugin.platforms ?? []).map((p) => p.name)))].sort()
const tiers = ['seed', 'verified', 'listed']
const tierLabel: Record<string, string> = { seed: 'Maintainer', verified: 'Verified community', listed: 'Community' }
---

<Base title="Plugins" description="Every Datadog RUM community plugin: commerce platforms, consent managers and login providers.">
  <h1>Plugins</h1>
  <p class="lede">
    Every adapter emits the same schema, so one dashboard and one monitor set work across all of them.
    Each card links to the plugin's page: install snippets, options, the events it actually sends, and
    what it touches.
  </p>

  <div class="filters">
    <input type="search" id="q" placeholder="Search plugins…" aria-label="Search plugins" />
    <select id="family" aria-label="Filter by family">
      <option value="">All families</option>
      {families.map((family) => <option value={family}>{family}</option>)}
    </select>
    <select id="platform" aria-label="Filter by platform">
      <option value="">All platforms</option>
      {platforms.map((platform) => <option value={platform}>{platform}</option>)}
    </select>
    <select id="tier" aria-label="Filter by tier">
      <option value="">All tiers</option>
      {tiers.map((tier) => <option value={tier}>{tierLabel[tier]}</option>)}
    </select>
  </div>

  <div class="grid" id="gallery">
    {plugins.map((plugin) => (
      <div
        class="card"
        data-plugin={plugin.name}
        data-family={plugin.family}
        data-tier={plugin.tier}
        data-platforms={(plugin.platforms ?? []).map((p) => p.name).join('|')}
        data-search={`${plugin.name} ${plugin.title ?? ''} ${plugin.description}`.toLowerCase()}
      >
        <h3><a href={url(`/plugins/${plugin.name}/`)}>{plugin.title ?? plugin.name}</a></h3>
        <p>{plugin.description}</p>
        <div class="badges">
          <span class={`badge ${plugin.tier}`}>{tierLabel[plugin.tier]}</span>
          <span class="badge">{plugin.family}</span>
          <span class="badge">v{plugin.version}</span>
          {plugin.events.length > 0 && <span class="badge">{plugin.events.length} actions</span>}
        </div>
      </div>
    ))}
  </div>

  <p id="empty" hidden class="muted">No plugin matches those filters.</p>

  <h2>Tiers</h2>
  <div class="scroll-x">
    <table>
      <thead>
        <tr><th>Tier</th><th>Who maintains it</th><th>Bar to be listed</th></tr>
      </thead>
      <tbody>
        <tr><td><span class="badge seed">Maintainer</span></td><td>Project maintainer, best effort</td><td>Core, schema, asset pack and the launch adapters</td></tr>
        <tr><td><span class="badge verified">Verified community</span></td><td>A named community maintainer</td><td>Passes the conformance suite, has a demo page, reviewed by a core maintainer</td></tr>
        <tr><td><span class="badge">Community</span></td><td>Anyone</td><td>Valid manifest and passing CI</td></tr>
      </tbody>
    </table>
  </div>
</Base>

<script>
  // Client-side filtering over the cards the build already rendered, so the gallery works
  // without a search service and stays usable with JS off (every card is in the HTML).
  const gallery = document.getElementById('gallery')!
  const empty = document.getElementById('empty')!
  const query = document.getElementById('q') as HTMLInputElement
  const family = document.getElementById('family') as HTMLSelectElement
  const platform = document.getElementById('platform') as HTMLSelectElement
  const tier = document.getElementById('tier') as HTMLSelectElement

  function apply() {
    const text = query.value.trim().toLowerCase()
    let visible = 0

    for (const card of gallery.querySelectorAll<HTMLElement>('[data-plugin]')) {
      const matches =
        (text === '' || (card.dataset.search ?? '').includes(text)) &&
        (family.value === '' || card.dataset.family === family.value) &&
        (tier.value === '' || card.dataset.tier === tier.value) &&
        (platform.value === '' || (card.dataset.platforms ?? '').split('|').includes(platform.value))

      card.hidden = !matches
      if (matches) visible += 1
    }

    empty.hidden = visible > 0
  }

  for (const control of [query, family, platform, tier]) {
    control.addEventListener('input', apply)
  }
</script>
