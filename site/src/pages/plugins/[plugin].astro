---
import Base from '../../layouts/Base.astro'
import InstallTabs from '../../components/InstallTabs.astro'
import Footprint from '../../components/Footprint.astro'
import { url } from '../../lib/url'
import plugins from '../../data/plugins.json'

export function getStaticPaths() {
  return plugins.map((plugin) => ({ params: { plugin: plugin.name }, props: { plugin } }))
}

const { plugin } = Astro.props

// Taken from the manifest, not derived from the slug: `woocommerce` exports `wooCommercePlugin`.
const fnName = plugin.exportName
const tierLabel: Record<string, string> = { seed: 'Maintainer', verified: 'Verified community', listed: 'Community' }
---

<Base title={plugin.title ?? plugin.name} description={plugin.description}>
  <p class="small"><a href={url('/plugins/')}>← All plugins</a></p>
  <h1>{plugin.title ?? plugin.name}</h1>
  <p class="lede">{plugin.description}</p>

  <div class="badges" style="margin-bottom: 1.5rem">
    <span class={`badge ${plugin.tier}`}>{tierLabel[plugin.tier]}</span>
    <span class="badge">{plugin.family}</span>
    <span class="badge">v{plugin.version}</span>
    <span class="badge">schema {plugin.schemaVersion}</span>
  </div>

  <h2>Install</h2>
  <InstallTabs
    name={plugin.name}
    pkg={plugin.package}
    version={plugin.version}
    fnName={fnName}
    platform={plugin.install?.platform}
  />

  <h2>Events this plugin sends</h2>
  {plugin.events.length === 0 ? (
    <p class="muted">
      {plugin.family === 'consent'
        ? 'None. A consent adapter emits no custom actions of its own: it holds RUM until the visitor accepts, then reports the accepted categories as session context.'
        : 'No fixture run has been recorded yet, so there is nothing to show. Run the test suite to generate it.'}
    </p>
  ) : (
    <>
      <p class="small muted">
        Generated from this adapter's fixture run, not written by hand, so it describes what the code
        actually does. Attribute types are the schema's.
      </p>
      {plugin.events.map((event) => (
        <>
          <h3><code>{event.name}</code></h3>
          <div class="scroll-x">
            <table>
              <thead><tr><th>Attribute</th><th>Type</th></tr></thead>
              <tbody>
                {event.attributes.map((attribute) => (
                  <tr><td><code>{attribute.name}</code></td><td class="muted">{attribute.type}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
          <details>
            <summary class="small muted">Example from the fixtures</summary>
            <pre><code>{JSON.stringify(event.example, null, 2)}</code></pre>
          </details>
        </>
      ))}
    </>
  )}

  {Object.keys(plugin.globalContext ?? {}).length > 0 && (
    <>
      <h2>Session context it sets</h2>
      <div class="scroll-x">
        <table>
          <thead><tr><th>Property</th><th>Example value</th></tr></thead>
          <tbody>
            {Object.entries(plugin.globalContext).map(([key, value]) => (
              <tr><td><code>{key}</code></td><td class="muted"><code>{JSON.stringify(value)}</code></td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  <h2>What it touches</h2>
  <Footprint footprint={plugin.footprint} />

  {plugin.options && plugin.options.length > 0 && (
    <>
      <h2>Options</h2>
      <div class="scroll-x">
        <table>
          <thead><tr><th>Option</th><th>Default</th><th>Effect</th></tr></thead>
          <tbody>
            {plugin.options.map((option) => (
              <tr>
                <td><code>{option.name}</code></td>
                <td class="muted"><code>{option.default === null ? 'none' : JSON.stringify(option.default)}</code></td>
                <td>{option.description}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  <h2>Compatibility and maintainer</h2>
  <div class="scroll-x">
    <table>
      <tbody>
        <tr><th scope="row">RUM SDK</th><td><code>@datadog/browser-rum@{plugin.rumSdk}</code></td></tr>
        <tr><th scope="row">Schema</th><td><code>{plugin.schemaVersion}</code> · <a href={url('/docs/schema/')}>reference</a></td></tr>
        {plugin.platforms && plugin.platforms.length > 0 && (
          <tr>
            <th scope="row">Platforms</th>
            <td>
              {plugin.platforms.map((platform) => (
                <div>
                  <strong>{platform.name}</strong>
                  {platform.versions && <> <code>{platform.versions}</code></>}
                  {platform.notes && <div class="small muted">{platform.notes}</div>}
                </div>
              ))}
            </td>
          </tr>
        )}
        <tr>
          <th scope="row">Maintainer</th>
          <td>{plugin.maintainer.name} (<a href={`https://github.com/${plugin.maintainer.github}`}>@{plugin.maintainer.github}</a>)</td>
        </tr>
        <tr>
          <th scope="row">Source</th>
          <td><a href={`https://github.com/kyletaylored/datadog-rum-community-plugins/tree/main/packages/plugin-${plugin.name}`}>packages/plugin-{plugin.name}</a></td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2>Verify the install</h2>
  <ol class="steps">
    <li>
      Pass <code>debug: true</code> and reload. Every mapped event prints to the console, along with the
      plugin's declared footprint.
      <pre><code>{`plugins: [${fnName}({ debug: true })]`}</code></pre>
    </li>
    <li>
      Query the RUM Explorer for the first action. It should appear within a minute of the first matching
      interaction on the site.
      <pre><code>{plugin.events.length > 0
        ? `@type:action @action.name:${plugin.events[0].name}`
        : '@type:session @context.consent.categories:*'}</code></pre>
    </li>
    <li>
      Reconcile against the platform's own report before trusting the numbers. These are browser-measured
      and will undercount; the accuracy bar is within 5% of the platform admin over 7 days.
    </li>
  </ol>
</Base>
