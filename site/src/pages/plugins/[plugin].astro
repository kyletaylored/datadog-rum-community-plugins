---
import PluginPage from '../../layouts/PluginPage.astro'
import plugins from '../../data/plugins.json'

export function getStaticPaths() {
  // A plugin with a hand-written page next to this file renders there instead.
  const custom = Object.keys(import.meta.glob('./*.astro')).map((path) => path.slice(2, -'.astro'.length))
  return plugins
    .filter((plugin) => !custom.includes(plugin.name))
    .map((plugin) => ({ params: { plugin: plugin.name }, props: { plugin } }))
}

const { plugin } = Astro.props
---

<PluginPage plugin={plugin} />
