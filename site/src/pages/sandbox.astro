---
import Base from '../layouts/Base.astro'
import { url } from '../lib/url'
import plugins from '../data/plugins.json'

const order = ['shopify', 'woocommerce', 'onetrust']
const runnable = order
  .map((name) => plugins.find((plugin) => plugin.name === name))
  .filter((plugin) => plugin !== undefined)
---

<Base title="Sandbox" description="Watch exactly what a Datadog RUM plugin sends, and what it refuses to send.">
  <h1>Sandbox</h1>
  <p class="lede">
    A shopper clicks through a store. Watch exactly what the plugin sends to Datadog — and what it
    refuses to send. Runs the real plugin in your browser; no Datadog account needed.
  </p>

  <div class="sandbox" data-sandbox>
    <div class="bar">
      <label class="pick">
        <span>Plugin</span>
        <select id="adapter">
          {runnable.map((plugin, index) => (
            <option value={plugin.name} selected={index === 0}>{plugin.title ?? plugin.name}</option>
          ))}
        </select>
      </label>
      <div class="presets" data-presets></div>
    </div>

    <p class="explain" data-explain></p>

    <div class="panes">
      <section class="pane">
        <h2>A shopper on the store</h2>
        <ol class="step-list" data-steps></ol>
        <button type="button" class="primary" data-run-all>Run every step</button>
        <button type="button" class="ghost" data-reset>Reset</button>
      </section>

      <section class="pane">
        <h2>What Datadog receives</h2>
        <div class="log" data-log aria-live="polite"></div>
      </section>
    </div>

    <details class="settings">
      <summary>Plugin options</summary>
      <div class="opts">
        <label><input type="checkbox" data-option="consentIgnore" /> Visitor has accepted the cookie banner</label>
        <label><input type="checkbox" data-option="includeItems" /> Send line items <code>includeItems</code></label>
        <label><input type="checkbox" data-option="includeEmail" /> Send email address <code>includeEmail</code></label>
        <label><input type="checkbox" data-option="includeName" /> Send customer name <code>includeName</code></label>
        <label><input type="checkbox" data-option="identifyUsers" checked /> Identify the customer <code>identifyUsers</code></label>
        <label class="inline" data-shopify-only>
          Shopify consent API
          <select id="privacy">
            <option value="absent" selected>Not present (pixel sandbox)</option>
            <option value="allowed">Allows analytics</option>
            <option value="denied">Blocks analytics</option>
          </select>
        </label>
        <label class="inline" data-onetrust-only hidden>
          Required category
          <input id="category" type="text" value="C0002" spellcheck="false" size="8" />
        </label>
        <label class="inline" data-commerce-prefix>
          Action prefix
          <input id="prefix" type="text" value="commerce." spellcheck="false" size="12" />
        </label>
      </div>
    </details>
  </div>

  <p class="small muted">
    Nothing leaves your browser. The sandbox never starts RUM and never asks for an application ID or
    client token — it records the calls the plugin would make. That is also the only way to show a
    <em>refusal</em>, since a blocked event produces nothing at all.
    <a href={url('/docs/privacy/')}>How the rules work →</a>
  </p>
</Base>

<style is:global>
  /* Global on purpose: the rows and log entries are built in the client script, so Astro's
     scoped-style hash never reaches them. Every selector is namespaced under .sandbox. */
  .sandbox { margin: 1.5rem 0 1rem; }

  .sandbox .bar {
    display: flex;
    gap: 0.75rem;
    align-items: flex-end;
    flex-wrap: wrap;
    margin-bottom: 0.9rem;
  }
  .sandbox .pick { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); font-weight: 600; }
  .sandbox .pick select {
    font: inherit;
    font-size: 1rem;
    text-transform: none;
    letter-spacing: normal;
    color: var(--text);
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--raised);
  }
  .sandbox .presets { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-left: auto; }
  .sandbox .presets button {
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    cursor: pointer;
  }
  .sandbox .presets button:hover { background: var(--accent); color: var(--accent-ink); }

  .sandbox .explain {
    margin: 0 0 1rem;
    padding: 0.6rem 0.9rem;
    border-left: 3px solid var(--accent);
    background: var(--surface);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: 0.925rem;
  }
  .sandbox .explain:empty { display: none; }

  .sandbox .panes { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 1rem; align-items: start; }
  @media (max-width: 52rem) { .sandbox .panes { grid-template-columns: 1fr; } }

  .sandbox .pane {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--raised);
    box-shadow: var(--shadow);
    padding: 1rem 1.1rem;
  }
  .sandbox .pane h2 {
    margin: 0 0 0.75rem;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }
  .sandbox .pane .primary { margin-top: 0.75rem; }
  .sandbox .pane .ghost {
    font: inherit;
    font-size: 0.875rem;
    margin-left: 0.4rem;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .sandbox .pane .ghost:hover { color: var(--text); border-color: var(--accent); }

  .sandbox .step-list { list-style: none; padding: 0; margin: 0; }
  .sandbox .step-list li {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--border);
  }
  .sandbox .step-list li:last-child { border-bottom: none; }
  .sandbox .step-list .n {
    width: 1.5rem; height: 1.5rem; flex: none;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    display: grid; place-items: center;
    font-size: 0.75rem; font-weight: 700; color: var(--muted);
  }
  .sandbox .step-list li[data-done] .n { background: var(--accent); border-color: transparent; color: var(--accent-ink); }
  .sandbox .step-list .what { flex: 1; font-size: 0.9rem; }
  .sandbox .step-list button {
    font: inherit;
    font-size: 0.8rem;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--raised);
    color: var(--text);
    cursor: pointer;
  }
  .sandbox .step-list button:hover { border-color: var(--accent); color: var(--accent); }

  .sandbox .log { min-height: 16rem; max-height: 32rem; overflow-y: auto; font-size: 0.8125rem; }
  .sandbox .log .empty { color: var(--muted); font-size: 0.875rem; }
  .sandbox .entry { padding: 0.45rem 0; border-bottom: 1px solid var(--border); }
  .sandbox .entry:last-child { border-bottom: none; }
  .sandbox .entry .api { font-weight: 700; }
  .sandbox .entry.sent .api { color: var(--ok); }
  .sandbox .entry.stopped { background: var(--stop-soft); border-radius: 6px; padding: 0.45rem 0.6rem; margin: 0.25rem 0; }
  .sandbox .entry.stopped .api { color: var(--stop); }
  .sandbox .entry.meta .api { color: var(--muted); font-weight: 600; }
  .sandbox .entry pre { margin: 0.3rem 0 0; padding: 0.45rem 0.6rem; font-size: 0.75rem; background: var(--code-bg); }
  .sandbox .heading {
    font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--muted); font-weight: 700;
    margin: 0.9rem 0 0.2rem; padding-top: 0.4rem; border-top: 1px dashed var(--border);
  }
  .sandbox .heading:first-child { margin-top: 0; border-top: none; padding-top: 0; }

  .sandbox .settings { margin-top: 1rem; }
  .sandbox .settings summary {
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
    padding: 0.4rem 0;
  }
  .sandbox .settings summary:hover { color: var(--text); }
  .sandbox .opts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 0.5rem 1.25rem;
    padding: 0.75rem 0 0;
  }
  .sandbox .opts label { display: flex; gap: 0.45rem; align-items: center; font-size: 0.875rem; }
  .sandbox .opts label.inline { gap: 0.5rem; }
  .sandbox .opts input[type='text'],
  .sandbox .opts select {
    font: inherit; font-size: 0.85rem;
    padding: 0.25rem 0.45rem;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--raised);
    color: var(--text);
  }
</style>

<script>
  import { clearDedupe, startSession, type SandboxAdapter, type SandboxCall, type SandboxFixture } from '../lib/sandbox'
  import { labelFor } from '../lib/sandboxLabels'
  import plugins from '../data/plugins.json'

  const root = document.querySelector<HTMLElement>('[data-sandbox]')
  if (root) {
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!
    const adapterSelect = $<HTMLSelectElement>('#adapter')
    const prefixInput = $<HTMLInputElement>('#prefix')
    const privacySelect = $<HTMLSelectElement>('#privacy')
    const categoryInput = $<HTMLInputElement>('#category')
    const stepList = $<HTMLOListElement>('[data-steps]')
    const log = $<HTMLElement>('[data-log]')
    const explain = $<HTMLElement>('[data-explain]')
    const presetBar = $<HTMLElement>('[data-presets]')
    const optionInputs = [...root.querySelectorAll<HTMLInputElement>('[data-option]')]
    const option = (name: string) => optionInputs.find((input) => input.dataset.option === name)!

    type PluginData = { name: string; fixtures: SandboxFixture[] }
    const byName = new Map((plugins as PluginData[]).map((plugin) => [plugin.name, plugin]))

    let session: ReturnType<typeof startSession> | null = null
    let sentThisStep = 0

    /**
     * Each preset configures the plugin, runs the whole flow, and says in one line what to look
     * for. Telling someone to go and set four checkboxes is how the previous version lost people.
     */
    const PRESETS: Record<string, { label: string; apply: () => void; note: string }[]> = {
      shopify: [
        {
          label: 'Happy path',
          apply: () => { privacySelect.value = 'absent'; option('includeItems').checked = true },
          note: 'The normal case: every step maps to one Datadog action. The order arrives once, with its value, tax, shipping and coupon.',
        },
        {
          label: 'Shopper declines cookies',
          apply: () => { privacySelect.value = 'denied' },
          note: 'Shopify’s consent API says no, so the plugin sends nothing at all — not even the order. Every step is refused, with the reason.',
        },
        {
          label: 'Thank-you page reloaded',
          apply: () => { privacySelect.value = 'absent' },
          note: 'The last two steps are the same order: a reload. The second is refused, so revenue is not counted twice.',
        },
        {
          label: 'Card data in the payload',
          apply: () => { privacySelect.value = 'absent' },
          note: 'The payment step’s recorded payload contains a card number and CVV. Look at what arrives: only the payment method name.',
        },
      ],
      woocommerce: [
        {
          label: 'Happy path',
          apply: () => { option('consentIgnore').checked = true; option('includeItems').checked = true },
          note: 'Cart events come from WooCommerce’s own DOM events; the order comes from the thank-you page. Note the card number and billing address in the payload never arrive.',
        },
        {
          label: 'Cookie banner unanswered',
          apply: () => { option('consentIgnore').checked = false },
          note: 'Nothing is sent, not even the customer ID, and RUM itself is held at not-granted. Pending events are dropped rather than queued, so accepting later does not backfill them.',
        },
        {
          label: 'Send the email address',
          apply: () => { option('consentIgnore').checked = true; option('includeEmail').checked = true },
          note: 'Opted in, the email appears on setUser — and nowhere else. It is never attached to an action.',
        },
      ],
      onetrust: [
        {
          label: 'Walk the banner',
          apply: () => { categoryInput.value = 'C0002' },
          note: 'RUM is held until the analytics category is accepted, then released. Turning it back off withdraws consent.',
        },
        {
          label: 'Require a stricter category',
          apply: () => { categoryInput.value = 'C0004' },
          note: 'Now only "accepts all cookies" releases RUM. Accepting analytics alone is not enough.',
        },
      ],
    }

    const currentOptions = () => ({
      includeItems: option('includeItems').checked,
      includeEmail: option('includeEmail').checked,
      includeName: option('includeName').checked,
      identifyUsers: option('identifyUsers').checked,
      ...(option('consentIgnore').checked ? { consent: 'ignore' as const } : {}),
      actionPrefix: prefixInput.value || 'commerce.',
      shopifyPrivacy: privacySelect.value as 'absent' | 'allowed' | 'denied',
      category: categoryInput.value || 'C0002',
    })

    function heading(text: string) {
      const el = document.createElement('p')
      el.className = 'heading'
      el.textContent = text
      log.append(el)
      log.scrollTop = log.scrollHeight
    }

    // Green means business data actually reached Datadog. Session setup — context properties, the
    // consent state — is listed but muted: it is not an order, and colouring it the same as one is
    // what makes "nothing was sent" look like "seven things were sent".
    const DATA_CALLS = new Set(['addAction', 'setUser', 'setAccount'])

    function render(call: SandboxCall) {
      const entry = document.createElement('div')
      const kind = call.blocked ? 'stopped' : DATA_CALLS.has(call.api) ? 'sent' : 'meta'
      entry.className = `entry ${kind}`

      const head = document.createElement('div')
      const api = document.createElement('span')
      api.className = 'api'
      api.textContent = call.blocked ? `✕ not sent` : call.api
      head.append(api)

      if (call.label) {
        const label = document.createElement('code')
        label.textContent = ` ${call.label}`
        head.append(label)
      }
      if (call.blocked) {
        const reason = document.createElement('span')
        reason.className = 'muted small'
        reason.textContent = ` — ${call.blocked}`
        head.append(reason)
      }
      entry.append(head)

      const detail = call.detail as Record<string, unknown> | undefined
      if (detail !== undefined && Object.keys(detail ?? {}).length > 0) {
        const pre = document.createElement('pre')
        pre.textContent = JSON.stringify(detail, null, 2)
        entry.append(pre)
      }

      log.append(entry)
      log.scrollTop = log.scrollHeight
    }

    function emptyLog() {
      log.replaceChildren()
      const p = document.createElement('p')
      p.className = 'empty'
      p.textContent = 'Run a step to see what the plugin sends.'
      log.append(p)
    }

    function reset() {
      emptyLog()
      clearDedupe()
      for (const li of stepList.querySelectorAll('li')) li.removeAttribute('data-done')
      session?.dispose()
      session = startSession(adapterSelect.value as SandboxAdapter, currentOptions(), (call) => {
        if (log.querySelector('.empty')) log.replaceChildren()
        sentThisStep += 1
        render(call)
      })
    }

    function fire(fixture: SandboxFixture, label: string, li?: HTMLElement) {
      if (log.querySelector('.empty')) log.replaceChildren()
      sentThisStep = 0
      heading(label)
      session?.emit(fixture)
      if (sentThisStep === 0) render({ api: '', blocked: 'the plugin sent nothing for this step' })
      li?.setAttribute('data-done', '')
    }

    function fixturesFor(adapter: string) {
      const list = byName.get(adapter)?.fixtures ?? []
      const seen = new Set<string>()
      return list.map((fixture) => {
        const before = seen.has(fixture.event)
        seen.add(fixture.event)
        return { fixture, label: labelFor(fixture.name, fixture.event, before) }
      })
    }

    function renderSteps() {
      stepList.replaceChildren()
      fixturesFor(adapterSelect.value).forEach((step, index) => {
        const li = document.createElement('li')

        const n = document.createElement('span')
        n.className = 'n'
        n.textContent = String(index + 1)

        const what = document.createElement('span')
        what.className = 'what'
        what.textContent = step.label
        what.title = `${step.fixture.name} · ${step.fixture.event}`

        const run = document.createElement('button')
        run.type = 'button'
        run.textContent = 'Run'
        run.addEventListener('click', () => fire(step.fixture, step.label, li))

        li.append(n, what, run)
        stepList.append(li)
      })
    }

    function runAll() {
      reset()
      for (const step of fixturesFor(adapterSelect.value)) {
        const li = [...stepList.querySelectorAll('li')].find((el) => el.querySelector('.what')?.textContent === step.label)
        fire(step.fixture, step.label, li)
      }
    }

    function renderPresets() {
      presetBar.replaceChildren()
      for (const preset of PRESETS[adapterSelect.value] ?? []) {
        const button = document.createElement('button')
        button.type = 'button'
        button.textContent = preset.label
        button.addEventListener('click', () => {
          // Start from the defaults so presets don't inherit each other's state.
          for (const input of optionInputs) input.checked = input.dataset.option === 'identifyUsers'
          privacySelect.value = 'absent'
          prefixInput.value = 'commerce.'
          preset.apply()
          explain.textContent = preset.note
          runAll()
        })
        presetBar.append(button)
      }
    }

    function syncControls() {
      const adapter = adapterSelect.value
      $<HTMLElement>('[data-shopify-only]').hidden = adapter !== 'shopify'
      $<HTMLElement>('[data-onetrust-only]').hidden = adapter !== 'onetrust'
      // A consent plugin emits no actions of its own, so the commerce options mean nothing for it.
      const commerce = adapter !== 'onetrust'
      for (const input of optionInputs) input.closest('label')!.hidden = !commerce
      $<HTMLElement>('[data-commerce-prefix]').hidden = !commerce
    }

    $('[data-run-all]').addEventListener('click', () => { explain.textContent = ''; runAll() })
    $('[data-reset]').addEventListener('click', () => { explain.textContent = ''; reset() })

    adapterSelect.addEventListener('change', () => {
      explain.textContent = ''
      syncControls()
      renderPresets()
      renderSteps()
      reset()
    })

    for (const input of [...optionInputs, prefixInput, privacySelect, categoryInput]) {
      input.addEventListener('change', () => reset())
    }

    window.addEventListener('pagehide', () => session?.dispose(), { once: true })

    syncControls()
    renderPresets()
    renderSteps()
    reset()
  }
</script>
