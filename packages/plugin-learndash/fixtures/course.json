      "payload": { "html": "<input type=\"button\" name=\"startQuiz\" value=\"Start quiz\" class=\"wpProQuiz_button\">" }
    },
    {
      "name": "passes the quiz",
      "event": "page",
      "payload": {
        "user": { "id": 57 },
        "course": { "id": 1204, "title": "Incident response basics" },
        "events": [
          { "id": "quiz-57-1402-1", "type": "quiz_graded", "course_id": 1204, "quiz_id": 1402, "quiz_title": "Status updates check", "score": 8, "score_max": 10, "passed": true, "attempt": 1, "answers": ["B", "D", "A"] }
        ]
      }
    },
    {
      "name": "completes the course",
