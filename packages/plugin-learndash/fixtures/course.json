        "course": { "id": 1204, "title": "Incident response basics" },
        "events": [
          { "id": "step-57-1331", "type": "step_complete", "course_id": 1204, "step_id": 1331, "step_title": "Running the retro", "step_type": "lesson", "progress_percent": 100 },
          { "id": "complete-57-1204", "type": "course_complete", "course_id": 1204, "course_title": "Incident response basics" }
        ]
      }
