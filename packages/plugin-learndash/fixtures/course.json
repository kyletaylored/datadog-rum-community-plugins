    {
      "name": "enrols in a course",
      "event": "page",
      "payload": {
        "user": { "id": 57, "email": "learner@example.com", "display_name": "Sam Learner" },
        "course": { "id": 1204, "title": "Incident response basics" },
        "events": [{ "id": "enroll-57-1204", "type": "course_enroll", "course_id": 1204, "course_title": "Incident response basics" }]
      }
    },
    {
      "name": "completes a lesson",
      "event": "page",
      "payload": {
        "user": { "id": 57 },
        "course": { "id": 1204, "title": "Incident response basics" },
        "step": { "id": 1312, "title": "Choosing a severity", "type": "lesson" },
        "events": [
          { "id": "step-57-1311", "type": "step_complete", "course_id": 1204, "step_id": 1311, "step_title": "Writing a status update", "step_type": "lesson", "progress_percent": 40 }
        ]
      }
    },
    {
      "name": "completes a topic",
      "event": "page",
      "payload": {
        "user": { "id": 57 },
        "course": { "id": 1204, "title": "Incident response basics" },
        "step": { "id": 1402, "title": "Status updates check", "type": "quiz" },
        "events": [
          { "id": "step-57-1321", "type": "step_complete", "course_id": 1204, "step_id": 1321, "step_title": "Severity in practice", "step_type": "topic", "progress_percent": 60 }
        ]
      }
    },
    {
      "name": "starts the quiz",
