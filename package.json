{
  "name": "datadog-rum-community-plugins-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Kyle Taylor <kyle.taylor@datadoghq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyletaylored/datadog-rum-community-plugins.git"
  },
  "workspaces": [
    "packages/*",
    "site"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "lint:manifests": "node scripts/validate-manifests.mjs",
    "size": "node scripts/size-check.mjs",
    "gen:schema-docs": "node scripts/gen-schema-docs.mjs",
    "new-plugin": "node scripts/new-plugin.mjs",
    "verify": "npm run build && npm test && npm run lint:manifests && npm run size && npm run site:build",
    "site:build": "npm run build:site --workspace site",
    "site:dev": "npm run dev --workspace site",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-plugin-versions.mjs",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@datadog/browser-rum": "^7.16.1",
    "@types/node": "^26.6.5",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "ajv": "^8.20.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  }
}
